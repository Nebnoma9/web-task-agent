# Copy to .env (git-ignored) and fill in only what you use. `wta run` loads .env automatically.
# The scripted policy needs none of this.

# --- OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# WTA_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
# WTA_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Cohere (images are sent only to vision models, e.g. command-a-vision-07-2025) ---
COHERE_API_KEY=
# WTA_COHERE_MODEL=command-a-vision-07-2025

# --- Ollama (local) ---
# OLLAMA_HOST=http://localhost:11434
# WTA_OLLAMA_MODEL=llama3.2-vision

# Set to 0 to never send screenshots, whatever the provider supports.
# WTA_VISION=1

# Use a specific Chromium binary instead of Playwright's bundled one
# (useful when the browser build and the Playwright package version differ).
# WTA_CHROMIUM_EXECUTABLE=/path/to/chrome
